<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Keep Nuru Radio playing when the phone locks or the app backgrounds.
	     Merged with the Xcode-generated Info.plist (GENERATE_INFOPLIST_FILE stays YES). -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- QR event check-in (CheckInScannerView) — shown on the first camera ask. -->
	<key>NSCameraUsageDescription</key>
	<string>Nuru uses the camera to scan the event check-in code.</string>
	<!-- nuru:// deep links — the home-screen widgets open straight into their
	     surface (nuru://pathway, nuru://plans, nuru://chat, nuru://radio). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>org.nuruplace.member</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>nuru</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
